<Window
    x:Class="DMCommandTable.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="DM Command Table Local">
    <Grid x:Name="Root" RequestedTheme="Dark" Background="#0B0D12">
        <Grid.Resources>
            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#10131A" />
            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="#10131A" />
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="#0B0D12" />
            <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="#FCD34D" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#282219" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="#FCD34D" />
            <SolidColorBrush x:Key="TextControlBackground" Color="#191D27" />
            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#202532" />
            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#191D27" />
            <SolidColorBrush x:Key="TextControlForeground" Color="#F5F0E5" />
            <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#F5F0E5" />
            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#FCD34D" />
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <InfoBar x:Name="Notice" IsClosable="True" />
        <NavigationView x:Name="Navigation" Grid.Row="1"
                        IsBackButtonVisible="Collapsed" IsSettingsVisible="False"
                        SelectionChanged="Navigate" OpenPaneLength="224"
                        Background="#10131A">
            <NavigationView.PaneHeader>
                <TextBlock Text="DM Command Table" Margin="12,0,0,0"
                           Foreground="#FCD34D" FontWeight="SemiBold" VerticalAlignment="Center" />
            </NavigationView.PaneHeader>
            <ScrollViewer HorizontalContentAlignment="Stretch" Background="#0B0D12">
                <StackPanel x:Name="Page" Margin="28,24,28,32" Spacing="16"
                            HorizontalAlignment="Stretch" />
            </ScrollViewer>
        </NavigationView>
    </Grid>
</Window>
