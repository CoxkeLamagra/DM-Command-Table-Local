<Window
    x:Class="DMCommandTable.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="DM Command Table Local">
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <InfoBar x:Name="Notice" IsClosable="True" />
        <NavigationView x:Name="Navigation" Grid.Row="1"
                        IsBackButtonVisible="Collapsed" IsSettingsVisible="False"
                        SelectionChanged="Navigate">
            <ScrollViewer>
                <StackPanel x:Name="Page" Margin="24" Spacing="12" MaxWidth="1100"
                            HorizontalAlignment="Stretch" />
            </ScrollViewer>
        </NavigationView>
    </Grid>
</Window>
